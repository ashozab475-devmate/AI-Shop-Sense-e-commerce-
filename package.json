{
  "name": "fypapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "search-service": "cd search_service && python start_server.py",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/api __tests__/lib",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "coverage:analyze": "node scripts/coverage-analysis.js",
    "coverage:badges": "node scripts/generate-badges.js",
    "coverage:report": "npm run test:coverage && npm run coverage:analyze && npm run coverage:badges"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "fs": "^0.0.1-security",
    "jose": "^6.1.3",
    "lucide-react": "^0.552.0",
    "next": "16.3.0",
    "next-auth": "^4.24.14",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5.0.0"
  }
}
